# The database of `npm run db:up` (docker-compose.yml). The server reads
# DATABASE_URL. Without it, `npm run dev` uses this database, and the built
# server in production exits.
DATABASE_URL=postgres://dd:dd@localhost:54329/dd
# The API tests (src/server/api.test.ts) run only when this is set. Each run
# makes a schema of its own in this database and drops it at the end.
TEST_DATABASE_URL=postgres://dd:dd@localhost:54329/dd
