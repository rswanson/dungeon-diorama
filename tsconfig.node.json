{
  // The tests, the end-to-end tests, the tool configs and the scripts: run by Node, never built.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/**/*.test.ts",
    "vite.config.ts",
    "scripts",
    "playwright.config.ts",
    "e2e"
  ]
}
