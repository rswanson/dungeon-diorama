{
  // The tests and the tool configs: run by Node, never built.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.test.ts", "vite.config.ts"]
}
