{
  // The options all three tsconfig files share.
  "compilerOptions": {
    "target": "ES2023",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  }
}
